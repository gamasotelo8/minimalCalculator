<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Calculadora" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="ButtonsTheme" parent="Base.Theme.Calculadora">
        <item name="buttonStyle">@style/Widget.AppCompat.Button</item>
        <item name="buttonBarButtonStyle">@style/Widget.AppCompat.Button.Borderless</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AppCompat.Button.Borderless</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AppCompat.Button.Borderless</item>
        <item name="android:textColor">#D3D3D3</item>
        <item name="android:textSize">30sp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:minWidth">80sp</item>
        <item name="android:minHeight">80sp</item>
        <item name="android:padding">0dp</item>
        <item name="android:fontFamily">@font/lato_regular</item>
    </style>

    <style name= "DeleteButtonsTheme" parent="ButtonsTheme">
        <item name="android:src">@drawable/dark_backspace_30</item>
    </style>
</resources>